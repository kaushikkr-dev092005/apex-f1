# The offline APEX demo requires no environment variables or service accounts.
# This file is documentation; Gradle does not inject it into the client.
# Optional production BACKEND configuration (never embed upstream secrets in an APK):
# TELEMETRY_PROVIDER_API_KEY=
# TELEMETRY_PROVIDER_BASE_URL=
# NEWS_PROVIDER_API_KEY=
# FCM_SERVICE_ACCOUNT_PATH=
# VOICE_PROVIDER_API_KEY=
# VOICE_PROVIDER_API_SECRET=
# DATABASE_URL=
# Client authentication should use short-lived user/room tokens from your backend.
# Optional standard-library gateway (backend/apex_backend.py), server environment only:
# APEX_BACKEND_PORT=8080
# APEX_CACHE_DB=backend/.apex-cache.sqlite3
# APEX_BACKEND_TOKEN=
# APEX_LLM_URL=https://your-provider.example/v1/chat/completions
# APEX_LLM_API_KEY=
# APEX_LLM_MODEL=
